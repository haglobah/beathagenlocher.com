---
import { getCollection, type CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'

import Il from './InnerLink.astro'
import CardHeader from './WideCard/CardHeader.astro'
import RecommendationDots from './RecommendationDots.astro'

type Props = { book: CollectionEntry<'books'>; id?: never } | { id: string; book?: never }

const props = Astro.props
const book = props.book ?? (await getCollection('books')).find((entry) => entry.id === props.id)
if (!book) {
  throw new Error(`<BookCard id="${props.id}" /> does not match any book in src/content/books/`)
}

const { title, authors, cover, recommendations } = book.data
---

<div class="f-mb-xl">
  <div
    class="group group/book relative grid f-pb-xs transition-all sm:grid-cols-8 sm:f-gap-xs lg:hover:!opacity-100 lg:group-hover/list:opacity-50"
  >
    <!-- Background element -->
    <div
      class="absolute f-left--16--24 f-right-2-12 f-top--16--24 f-bottom-0-0 z-0 rounded-md transition duration-300 ease-in-out lg:block lg:group-hover:bg-[rgb(51,51,57)] lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] group-hover:drop-shadow-lg"
    >
    </div>

    {
      cover ? (
        <Image
          src={cover}
          alt={`Cover of ${title}`}
          width={160}
          class="w-20 f-mb-xs rounded hover:drop-shadow sm:order-1 sm:col-span-2 sm:translate-y-1"
          loading="lazy"
        />
      ) : (
        <div
          class="w-20 f-mb-xs rounded hover:drop-shadow sm:order-1 sm:col-span-2 sm:translate-y-1 aspect-[2/3] bg-gradient-to-br from-cornflower/50 to-spacecadet flex items-center justify-center font-headline text-zinc-200 f-text-md"
          aria-hidden="true"
        >
          {title.charAt(0)}
        </div>
      )
    }

    <div class="z-10 sm:col-span-6 order-0 sm:order-2 relative">
      <div class="f-mb-xs">
        <h3 class="font-medium leading-snug text-zinc-200 max-w-[80%]">
          <Il href={book.id}>
            <CardHeader title={title} org="" />
          </Il>
        </h3>
        <div class="font-light text-zinc-200 f-text-xs">
          <span>{authors.join(', ')}</span>
        </div>
        {
          recommendations > 0 && (
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1 f-mt-2xs">
              <RecommendationDots count={recommendations} />
              <span
                aria-hidden="true"
                class="text-zinc-400 f-text-xs tabular-nums opacity-0 transition-opacity duration-150 group-hover/book:opacity-100 group-focus-within/book:opacity-100 motion-reduce:transition-none"
              >
                {recommendations} recommendation{recommendations === 1 ? '' : 's'}
              </span>
            </div>
          )
        }
      </div>
    </div>
  </div>
</div>
