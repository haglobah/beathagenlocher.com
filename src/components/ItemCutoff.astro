---
import Highlight from './Highlight.astro'

const { class: classList, after } = Astro.props
---

<div class:list={['item-cutoff-container relative', classList]} data-after={after}>
  <slot />
  <slot name="after-cutoff" />
  <div
    class="overlay absolute bottom-0 left-0 right-0 h-48 bg-gradient-to-t from-zinc-800 to-transparent flex justify-center items-end pointer-events-none"
  >
  </div>
  <div
    class="overlay absolute bottom-0 left-0 right-0 h-48 bg-gradient-to-t from-zinc-800 to-transparent flex justify-center items-end pointer-events-none"
  >
    <Highlight>...</Highlight>
  </div>
</div>

<script>
  for (const container of document.querySelectorAll<HTMLElement>('.item-cutoff-container')) {
    const after = Number(container.dataset.after)
    if (!Number.isInteger(after) || after < 0)
      throw new Error('ItemCutoff requires a non-negative integer after')
    Array.from(container.children).forEach((item, index) => {
      if (item.classList.contains('content-item')) item.classList.toggle('hidden', index >= after)
    })
  }
</script>
