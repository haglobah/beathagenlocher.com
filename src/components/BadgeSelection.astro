---
export interface Props {
  topics: readonly TopicCount[]
  size?: string
}
const { topics: allTopics, size } = Astro.props
import type { TopicCount } from '../content/helpers'
import Badge from './Badge.astro'
import Button from './Button.astro'
import { slug as slugger } from 'github-slugger'

const topicsWithSlugs = [...allTopics]
  .sort(([nameA, countA], [nameB, countB]) => countB - countA || nameA.localeCompare(nameB))
  .map(([name, count]) => ({ name, count, slug: slugger(name) }))

const instructionTextBaseClasses =
  'text-zinc-400 f-px-xs flex items-center transition-opacity duration-300 ease-in-out'
---

<div id="topic-filter" class="topic-filter flex flex-col justify-between">
  <!-- Selected topics section -->
  <div
    id="selected-topics-container"
    class="relative shrink-0 grow f-mt-sm f-min-h-lg border border-dashed border-zinc-700 rounded-xl f-p-sm"
  >
    <div id="selected-topics" class="flex flex-wrap gap-2 f-min-h-lg items-center w-[90%]">
      <!-- Selected topic elements will be moved here -->
      <span id="selected-placeholder" class="text-zinc-500 italic f-text-xs"
        >Selected filters will appear here...</span
      >
    </div>

    <div class="absolute inset-y-3 right-3 flex items-start">
      <Button
        id="clear-topics"
        class="my-auto f-text-sm transition-opacity opacity-0 pointer-events-none"
      >
        Clear
      </Button>
    </div>
  </div>

  <!-- Instruction text container -->
  <div id="instruction-text-container" class="f-my-sm f-mx-2xs flex justify-start gap-8 f-text-xs">
    <!-- Text that appears when topics can be removed -->
    <div id="has-selection-text" class:list={[instructionTextBaseClasses, 'opacity-0 text-center']}>
      Click topic <span
        class="i-heroicons:arrow-up-20-solid inline-block relative mx-1 size-5 text-cornflower"
      ></span> to remove
    </div>
    <!-- Text that appears when topics can be added -->
    <div
      id="not-all-selection-text"
      class:list={[instructionTextBaseClasses, 'opacity-100 text-center']}
    >
      Click topic <span
        class="i-heroicons:arrow-down-20-solid inline-block relative mx-1 size-5 text-cornflower"
      ></span> to add filter
    </div>
  </div>

  <!-- Available topics section - All topics start here -->
  <div
    id="available-topics"
    class="flex flex-wrap gap-2 f-mx-2xs min-h-[40px] flex-1 overflow-y-auto"
  >
    {
      topicsWithSlugs.map(({ name: topic, count: count, slug: slug }) => (
        <div
          id={'topic-wrapper-' + slug}
          data-topic={topic}
          class="topic-wrapper cursor-pointer transition-[opacity,transform] duration-300 ease-in-out hover:scale-105 focus:scale-105 focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cornflower focus-visible:rounded"
          aria-label={`Toggle topic: ${topic}`}
          role="button"
          tabindex="0"
        >
          <Badge topic={topic} count={count} size={size} />
        </div>
      ))
    }
  </div>
</div>

<script>
  import { selectedTopics, toggleTopic, clearTopics } from '../store.ts'

  function initializeTopics() {
    const root = document.getElementById('topic-filter')
    if (!root) return
    const filterWrapper: HTMLElement = root

    function requiredElement(id: string): HTMLElement {
      const element = filterWrapper.querySelector<HTMLElement>(`#${id}`)
      if (!element) throw new Error(`Topic filter is missing #${id}`)
      return element
    }

    const selectedContainer = requiredElement('selected-topics')
    const availableContainer = requiredElement('available-topics')
    const clearButton = requiredElement('clear-topics')
    const notAllSelectionText = requiredElement('not-all-selection-text')
    const hasSelectionText = requiredElement('has-selection-text')
    const selectedPlaceholder = requiredElement('selected-placeholder')

    const topics = Array.from(filterWrapper.querySelectorAll<HTMLElement>('.topic-wrapper')).map(
      (element) => {
        const name = element.dataset.topic
        if (!name) throw new Error('Topic filter badge is missing its topic')
        element.addEventListener('click', () => toggleTopic(name))
        element.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault()
            toggleTopic(name)
          }
        })
        return { name, element }
      },
    )

    function setVisible(element: HTMLElement, visible: boolean) {
      element.classList.toggle('opacity-100', visible)
      element.classList.toggle('opacity-0', !visible)
    }

    function updateUI(selected: readonly string[]) {
      const selection = new Set(selected)
      // Walk backwards so each moved badge can be inserted before its known successor.
      let nextSelected: HTMLElement | null = null
      let nextAvailable: HTMLElement | null = null
      for (let index = topics.length - 1; index >= 0; index--) {
        const { name, element } = topics[index]
        const isSelected = selection.has(name)
        const container = isSelected ? selectedContainer : availableContainer
        const next = isSelected ? nextSelected : nextAvailable
        if (element.parentElement !== container) container.insertBefore(element, next)
        element.setAttribute('aria-pressed', String(isSelected))
        if (isSelected) nextSelected = element
        else nextAvailable = element
      }

      const count = topics.filter(({ name }) => selection.has(name)).length
      const hasSelection = count > 0
      selectedPlaceholder.style.display = hasSelection ? 'none' : 'inline'
      setVisible(hasSelectionText, hasSelection)
      setVisible(notAllSelectionText, count < topics.length)
      setVisible(clearButton, hasSelection)
      clearButton.classList.toggle('pointer-events-auto', hasSelection)
      clearButton.classList.toggle('pointer-events-none', !hasSelection)
      for (const className of [
        'fixed',
        'top-0',
        'overflow-hidden',
        'shadow-2xl',
        'bg-zinc-800',
        'z-50',
      ]) {
        filterWrapper.classList.toggle(className, hasSelection)
      }
      availableContainer.classList.toggle('max-h-[140px]', hasSelection)
    }

    clearButton.addEventListener('click', clearTopics)
    const unsubscribe = selectedTopics.subscribe(updateUI)
    document.addEventListener('astro:before-swap', unsubscribe, { once: true })
  }

  initializeTopics()
</script>
