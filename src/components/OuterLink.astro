---
import { linkContent } from '../lib/linkContent'
const { href, arrow = true, class: className, ...attributes } = Astro.props
const isFootnote = 'data-footnote-ref' in attributes || 'data-footnote-backref' in attributes
const html = linkContent(await Astro.slots.render('default'))
---

{
  isFootnote ? (
    <a {...attributes} href={href} class:list={['footnote-link', className]}>
      <Fragment set:html={html} />
    </a>
  ) : (
    <a href={href} target="_blank" rel="noreferrer" class="group/outerlink">
      <span
        class:list={[
          'cursor-pointer font-medium group-hover/outerlink:text-cornflower-light transition duration-300 ease-in-out',
          className,
        ]}
      >
        <Fragment set:html={html} />
      </span>
      {arrow && (
        <span class="i-heroicons:arrow-right-20-solid relative left-[0.1em] top-[0.2em] text-cornflower group-hover/outerlink:text-cornflower-light transition-all duration-300 ease-in-out -rotate-45 inline-block group-hover/outerlink:translate-y-[0.08em] group-hover/outerlink:rotate-0 size-[1.2em]" />
      )}
    </a>
  )
}
