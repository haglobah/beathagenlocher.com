---
import { getCollection, type CollectionEntry } from 'astro:content'
import { render } from 'astro:content'

import Layout from '../layouts/Layout.astro'
import PostLayout from '../layouts/PostLayout.astro'
import BookLayout from '../layouts/BookLayout.astro'

type Props =
  | { entry: CollectionEntry<'books'>; type: 'book' }
  | { entry: CollectionEntry<'essays' | 'notes' | 'talks'>; type: 'essay' | 'note' | 'talk' }

export async function getStaticPaths() {
  const essays = await getCollection('essays')
  const notes = await getCollection('notes')
  const talks = await getCollection('talks')
  const books = await getCollection('books')

  return [
    ...books.map((entry) => ({
      params: { slug: entry.id },
      props: { entry, type: 'book' } as const,
    })),
    ...essays.map((entry) => ({
      params: { slug: entry.id },
      props: { entry, type: 'essay' } as const,
    })),
    ...notes.map((entry) => ({
      params: { slug: entry.id },
      props: { entry, type: 'note' } as const,
    })),
    ...talks.map((entry) => ({
      params: { slug: entry.id },
      props: { entry, type: 'talk' } as const,
    })),
  ]
}

const { entry, type } = Astro.props
const { Content, headings } = await render(entry)

const frontmatter = entry.data

import { components } from '../components/mdxcomponents.ts'
---

{
  type === 'book' ? (
    <Layout title={frontmatter.title}>
      <BookLayout book={entry}>
        <Content components={components} />
      </BookLayout>
    </Layout>
  ) : (
    <Layout title={frontmatter.title}>
      <PostLayout frontmatter={frontmatter} headings={headings}>
        <Content components={components} />
      </PostLayout>
    </Layout>
  )
}
