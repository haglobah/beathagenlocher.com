---
import Layout from '../layouts/Layout.astro'

import Heading from '../components/Heading.astro'
import Ol from '../components/OuterLink.astro'

import Books from '../content/books.astro'
---

<Layout title="The Library">
  <div class="f-mx-md">
    <div class="f-my-xl max-w-3xl mx-auto">
      <Heading>The Library</Heading>
      <p class="italic f-text-xs f-mb-lg">
        The books on my shelves, sorted straight from my <Ol
          href="https://www.zeneca.io/haglobah">Zeneca library</Ol
        >. Some of them have notes attached.
      </p>
      <Books />
    </div>
  </div>
</Layout>
